<?php
/** @var $block \Magento\Catalog\Block\Product\View */
$errorRequired = (int)$block->getRequest()->getParam('required_error');
?>
<?php if ($errorRequired) : ?>
<div class="message notice">
    <span><?= $block->escapeHtml(__("The product's required option(s) weren't entered. Make sure the options are entered and try again.")) ?></span>
</div>
<?php endif; ?>
